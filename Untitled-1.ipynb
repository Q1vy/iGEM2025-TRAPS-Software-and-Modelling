    "\n",
    "\n",
    "def dir_tree(directory: str, lvl = 1):\n",
    "    import os\n",
    "    tree = ''\n",
    "    for i in os.scandir(directory):\n",
    "        tree += \"\\t\"*lvl + f\"{i.name} \\n\"\n",
    "        if i.is_dir():\n",
    "            tree += dir_tree(i.path, lvl = lvl+1)"
